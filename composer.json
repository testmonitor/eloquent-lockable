{
    "name": "testmonitor/eloquent-lockable",
    "description": "Make Eloquent models read-only after they're locked. Prevents updates and deletes based on a `locked` attribute.",
    "type": "library",
    "keywords": [
        "testmonitor",
        "lockable",
        "eloquent",
        "model",
        "laravel"
    ],
    "authors": [
        {
            "name": "Thijs Kok",
            "email": "thijs.kok@cerios.com",
            "homepage": "https://www.testmonitor.com/",
            "role": "Lead Developer"
        },
        {
            "name": "Stephan Grootveld",
            "email": "stephan.grootveld@cerios.com",
            "homepage": "https://www.testmonitor.com/",
            "role": "Developer"
        },
        {
            "name": "Frank Keulen",
            "email": "frank.keulen@cerios.com",
            "homepage": "https://www.testmonitor.com/",
            "role": "Developer"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.4",
        "illuminate/database": "^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^3.6",
        "orchestra/testbench": "^10.0|^11.0",
        "laravel/pint": "^1.30",
        "rector/rector": "^2.6",
        "larastan/larastan": "^3.11"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "TestMonitor\\Lockable\\": "src",
            "TestMonitor\\Lockable\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TestMonitor\\Lockable\\Test\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "style": "vendor/bin/pint --test",
        "sniff": "vendor/bin/phpcs",
        "refactor": "vendor/bin/rector process --dry-run",
        "test": "vendor/bin/phpunit --no-coverage",
        "check": [
            "@style",
            "@sniff",
            "@analyse",
            "@refactor",
            "@test"
        ]
    },
    "prefer-stable": true,
    "license": "MIT"
}
